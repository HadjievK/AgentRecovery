{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HadjievK/AgentRecovery/main/schema/recovery-machine.schema.json",
  "title": "Agent Recovery State Machine",
  "description": "Normative schema for RECOVERY.yaml, draft 0.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "version",
    "spec_version",
    "applies_to",
    "initial",
    "states",
    "audit"
  ],
  "properties": {
    "name": {
      "$ref": "#/$defs/kebabIdentifier"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "spec_version": {
      "const": "agent-recovery/0.2"
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "effect_class"],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryIdentifier" }
        },
        "effect_class": {
          "enum": [
            "read-only",
            "reversible-write",
            "irreversible-write",
            "external-communication",
            "financial-action",
            "authority-change",
            "multi-step-workflow"
          ]
        }
      }
    },
    "initial": {
      "$ref": "#/$defs/kebabIdentifier"
    },
    "states": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "$ref": "#/$defs/kebabIdentifier" },
      "additionalProperties": { "$ref": "#/$defs/stateNode" }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record"],
      "properties": {
        "record": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/snakeIdentifier" }
        }
      }
    }
  },
  "$defs": {
    "kebabIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "snakeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "registryIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "eventIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "classification": {
      "enum": [
        "started",
        "effect-possible",
        "verifying",
        "verified-not-applied",
        "verified-applied",
        "unknown",
        "retry-safe",
        "compensating",
        "contained",
        "recovered",
        "escalated",
        "resume-pending",
        "closed"
      ]
    },
    "staticValue": {
      "oneOf": [
        { "type": "string", "maxLength": 256 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 256 } }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capability"],
      "properties": {
        "kind": {
          "enum": [
            "verify",
            "retry",
            "compensate",
            "contain",
            "revoke",
            "escalate",
            "resume",
            "audit"
          ]
        },
        "capability": { "$ref": "#/$defs/registryIdentifier" },
        "with": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/snakeIdentifier" },
          "additionalProperties": { "$ref": "#/$defs/staticValue" }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/kebabIdentifier" },
        "guard": { "$ref": "#/$defs/registryIdentifier" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "transitionSet": {
      "oneOf": [
        { "$ref": "#/$defs/transition" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        }
      ]
    },
    "eventMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/eventIdentifier" },
      "additionalProperties": { "$ref": "#/$defs/transitionSet" }
    },
    "stateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "description": { "type": "string", "maxLength": 512 },
        "classification": { "$ref": "#/$defs/classification" },
        "type": { "enum": ["atomic", "final"] },
        "entry": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "on": { "$ref": "#/$defs/eventMap" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "final" } },
            "required": ["type"]
          },
          "then": {
            "not": { "required": ["on"] }
          },
          "else": {
            "required": ["on"]
          }
        }
      ]
    }
  }
}
